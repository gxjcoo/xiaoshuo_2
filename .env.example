# 复制为 .env 后填写；勿将 .env 提交到版本库

# mimo | deepseek | doubao
LLM_PROVIDER=mimo

# MiMo（小米大模型，LLM_PROVIDER=mimo 时使用）
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 豆包 Ark（LLM_PROVIDER=doubao 时使用）
ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_USE_RESPONSES_API=0
# doubao-seed 系列模型默认可能开启思考模式（慢）。1=关闭思考（推荐）| 0=模型默认
DOUBAO_DISABLE_THINKING=1

# 可选：HTTP / 重试
# API_HTTP_CONNECT_TIMEOUT=30
# API_HTTP_READ_TIMEOUT=300
# API_MAX_RETRIES=5
# API_RETRY_BASE_DELAY=5

# 可选：审计（覆盖 audit_rules.json 中的阈值）
# AUDIT_PASS_THRESHOLD=85
# AUDIT_AI_TRACE_HARD_THRESHOLD=80
# AUDIT_NEAR_PASS_DELTA=3

# 可选：模式开关
# STRICT_SOURCE_PLOT=1   # 1=严格结构适配（默认）；0=实验/自由改编
# ENTITY_REWRITE=1       # 1=自动改写参考章实体名（默认）；0=保留原作角色/地名
# INTER_CHAPTER_SLEEP=5  # 章节间等待秒数（默认5），调试可设0，大批量可调大

# 调试
# DEBUG_LLM_LOG=0
