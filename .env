
# 复制为 .env 后填写；勿将 .env 提交到版本库

# deepseek | doubao
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 豆包 Ark（LLM_PROVIDER=doubao 时使用）
ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_USE_RESPONSES_API=0

# 可选：HTTP / 重试
# API_HTTP_CONNECT_TIMEOUT=30
# API_HTTP_READ_TIMEOUT=300
# API_MAX_RETRIES=5
# API_RETRY_BASE_DELAY=5

# 可选：审计（覆盖 audit_rules.json 中的阈值）
# AUDIT_PASS_THRESHOLD=85
# AUDIT_AI_TRACE_HARD_THRESHOLD=80
# AUDIT_NEAR_PASS_DELTA=3

# 调试
# DEBUG_LLM_LOG=0
